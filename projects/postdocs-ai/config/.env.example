# Copy to .env in this directory. Never commit .env.
TARGET_URL=https://app.postdocs.ai/
QA_PROJECT=postdocs-ai
MOCK_MODE=false

# Test identities (no passwords in repo)
POSTDOCS_OWNER_EMAIL=
POSTDOCS_COLLABORATOR_EMAIL=
POSTDOCS_INVITE_EMAIL=

# Optional — only if using password-based sign-in for collaborator account
POSTDOCS_COLLABORATOR_PASSWORD=
